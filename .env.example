# Network builds: pnpm dev:mainnet / pnpm build:mainnet explicitly set these
# public flags. Next.js exposes the existing VITE_* names through its config.
# Default builds remain testnet. Never put private keys in VITE_* values.
# VITE_ARC_NETWORK=mainnet
# VITE_MAINNET_SIGNING=1

# Optional future integration configuration. These do NOT enable live UI execution.
# Verified Arc testnet deployment addresses only. All VITE_* values are public.
VITE_ARC_ROUTER_ADDRESS=
VITE_ARC_AAVE_POOL_ADDRESS=
VITE_ARC_LAUNCHPAD_ADDRESS=

# Optional local TESTNET secret. Never set a VITE_ prefix or commit the populated .env.
# Current deployment scripts still use the encrypted keystore, not this variable.
ARC_TESTNET_DEPLOYER_PRIVATE_KEY=
ARC_TESTNET_DEPLOYER_ADDRESS=

# Fresh mainnet deployer; keep separate from the testnet key. Server/CLI only.
# Funding this wallet does not satisfy the audit, Safe, or deployment-confirmation gates.
MAINNET_DEPLOYER_PRIVATE_KEY=
MAINNET_DEPLOYER_ADDRESS=

# Server-only Pinata key with public file upload permission. NEVER use VITE_ for secrets.
PINATA_JWT=
MEDIA_PORT=5192
MEDIA_DATA_DIR=./storage
