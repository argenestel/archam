{
  "name": "arc-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "media": "node --env-file-if-exists=.env server/media.mjs",
    "dev": "next dev --hostname :: --port 5191",
    "build": "next build",
    "dev:mainnet": "VITE_ARC_NETWORK=mainnet VITE_MAINNET_SIGNING=1 next dev --hostname :: --port 5193",
    "build:mainnet": "VITE_ARC_NETWORK=mainnet VITE_MAINNET_SIGNING=1 next build",
    "preview:mainnet": "node scripts/preview.mjs --dir out-mainnet --host 0.0.0.0 --port 5194",
    "preview": "node scripts/preview.mjs --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src contracts server",
    "test:e2e": "playwright test",
    "test:preview": "node --test scripts/preview.test.mjs scripts/build-csp.test.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "wallet:create": "node scripts/testnet-wallet.mjs create",
    "wallet:status": "node scripts/testnet-wallet.mjs status",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "smoke:testnet": "node scripts/smoke-testnet.mjs",
    "format": "prettier --write src e2e scripts *.ts *.json *.md *.yaml docs",
    "deploy:orbit": "node scripts/deploy-orbit.mjs",
    "oracle:refresh": "node scripts/oracle-refresh.mjs",
    "agent": "node --import tsx --env-file-if-exists=agent/.env agent/run.mjs",
    "agent:mcp": "node --import tsx --env-file-if-exists=agent/.env agent/server.mjs",
    "verify:mainnet": "node scripts/verify-mainnet.mjs",
    "monitor": "node scripts/monitor.mjs",
    "deploy:mainnet": "node --env-file-if-exists=.env scripts/deploy-mainnet.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.19.0",
    "@circle-fin/app-kit": "^1.16.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@openzeppelin/contracts": "^5.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "prettier": "^3.9.9",
    "solc": "^0.8.30",
    "solc-0.8.19": "npm:solc@0.8.19",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  }
}
