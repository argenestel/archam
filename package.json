{
  "name": "arc-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src contracts",
    "test:e2e": "playwright test",
    "contracts:check": "node scripts/check-contracts.mjs",
    "wallet:create": "node scripts/testnet-wallet.mjs create",
    "wallet:status": "node scripts/testnet-wallet.mjs status",
    "deploy:testnet": "node scripts/deploy-testnet.mjs",
    "smoke:testnet": "node scripts/smoke-testnet.mjs",
    "format": "prettier --write src e2e scripts *.ts *.json *.md *.yaml docs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uniswap/v2-core": "1.0.1",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ethers": "^6.17.0",
    "ganache": "^7.9.2",
    "prettier": "^3.9.9",
    "solc": "^0.8.30",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
