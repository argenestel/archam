{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/test-ui.mjs",
    "test:swap-ui": "node scripts/test-swap-ui-local.mjs",
    "typecheck": "tsc --noEmit",
    "build:webpack": "next build --webpack",
    "export:v2": "node scripts/export-mofu-v2.mjs",
    "deploy:testnet": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local scripts/deploy-all-testnet.mjs",
    "verify:testnet": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.deploy.local scripts/verify-testnet.mjs",
    "verify:mainnet-router": "node --env-file-if-exists=.env.local scripts/verify-mainnet-router.mjs",
    "test:v2-local": "node scripts/test-mofu-v2-local.mjs",
    "test:v2-ui-local": "node scripts/test-v2-ui-local.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.17.1",
    "@circle-fin/app-kit": "^1.14.0",
    "@radix-ui/themes": "^3.3.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.102.8",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "@x402/extensions": "^2.25.0",
    "@x402/svm": "^2.25.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.56.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.1.2"
}
